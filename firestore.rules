rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: pastikan request memiliki auth token yang valid
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: kepemilikan dokumen yang sudah ada (untuk read, update, delete)
    function isDocOwner() {
      return isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        // Fallback backward-compatible untuk dokumen transisi tanpa userId
        (!('userId' in resource.data) || resource.data.userId == null || resource.data.userId == '')
      );
    }

    // Helper: data baru wajib mencantumkan userId pembuat yang sesuai
    function isOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ─── Profil Pengguna & Preferensi Multiakun ──────────────────────────────
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Koleksi Catatan CKP (Capaian Kinerja Pegawai) ───────────────────────
    match /ckp/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // ─── Koleksi Jadwal Kegiatan & Kalender ──────────────────────────────────
    match /schedule/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // ─── Koleksi Tugas & Manajemen Kanban ────────────────────────────────────
    match /tasks/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // ─── Koleksi SKP, Tim Kerja, dan Proyek ──────────────────────────────────
    match /skps/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    match /teams/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    match /projects/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // ─── Koleksi Kalender Cuti/Libur & Dinas Lapangan ────────────────────────
    match /holidays/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    match /dinas_lapangan/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // ─── Koleksi Pelatihan & Pengembangan Mandiri ────────────────────────────
    match /training_programs/{docId} {
      allow read:   if isDocOwner();
      allow create: if isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // ─── Pemetaan Chat ID Telegram per Pengguna ──────────────────────────────
    match /telegram_mappings/{chatId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── Tautan Singkat Berkas Dukung (Short Links) ──────────────────────────
    match /short_links/{docId} {
      allow read:   if true; // Publik untuk kebutuhan redirect link
      allow create: if isAuthenticated() && isOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // ─── Pencadangan Snapshot Cloud (Backups) ────────────────────────────────
    match /backups/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
